# Template documenting every variable. Real values live in .env.development / .env.staging / .env.production.
# All values ship inside the app binary, so NEVER put secrets here.
# Keep comments on their own line: the parser does not strip inline comments.

# development | staging | production
APP_ENV=development
# Home-screen name (iOS reads it through the xcconfig; Android uses the flavor resValue)
APP_DISPLAY_NAME=Explora Dev
# iOS bundle id (Android uses applicationIdSuffix per flavor)
APP_BUNDLE_ID=com.explora.dev
# Deep-link URL scheme, one per environment so side-by-side installs never collide.
# Android mirrors it in the flavor manifestPlaceholders (android/app/build.gradle).
APP_URL_SCHEME=explora-dev
# Remote activities API; empty = bundled JSON
API_URL=
# HTTP timeout in ms
API_TIMEOUT_MS=10000
# Dev builds only: multiply the seed data for perf testing (100 => 1200 items)
DEV_SEED_MULTIPLIER=0
