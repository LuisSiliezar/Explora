{
  "name": "Explora",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "yarn android:dev",
    "ios": "yarn ios:dev",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "pods": "cd ios && LANG=en_US.UTF-8 bundle exec pod install && cd ..",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" App.tsx",
    "validate": "yarn typecheck && yarn lint && yarn test",
    "ios:dev": "react-native run-ios --scheme Explora-Dev --simulator \"iPhone 17 Pro\"",
    "ios:staging": "react-native run-ios --scheme Explora-Staging --simulator \"iPhone 17 Pro\"",
    "ios:prod": "react-native run-ios --scheme Explora-Prod --mode Release --simulator \"iPhone 17 Pro\"",
    "android:dev": "react-native run-android --mode devDebug --appId com.explora.dev",
    "android:staging": "react-native run-android --mode stagingDebug --appId com.explora.staging",
    "android:prod": "react-native run-android --mode prodRelease --appId com.explora"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@shopify/flash-list": "^2.3.2",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "lottie-react-native": "^7.5.0",
    "lucide-react-native": "^1.47.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-bootsplash": "^7.3.3",
    "react-native-config": "^1.7.2",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.13.0",
    "sonner-native": "^0.27.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-export-namespace-from": "^7.25.9",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
